# 工商管理答题助手（BAH）环境配置示例
# 用法：复制为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）
#   cp .env.example .env
# 留空/不设置 = 使用代码内默认值。
#
# 权重获取自动适配：serve.py 会按 本地路径 → Hugging Face → ModelScope 的顺序解析。
# 有国际网络的电脑走 HF；中国大陆用户（HF 不可达）自动回退 ModelScope 国内直连，无需 VPN，
# 无需手动下载。首次运行只需联网，权重会自动缓存到 CACHE_DIR（或仓库 .model_cache/）。

# 基座模型：HF 名 / ModelScope 名 / 本地路径（默认 Qwen/Qwen2.5-3B-Instruct，双平台同名）
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# LoRA 适配器：HF 名 / ModelScope 名 / 本地 adapter 目录
# 默认值在双平台均有发布：HF=zhaoweichang/...，ModelScope=zhao1145141919/...（自动映射）
ADAPTER_PATH=zhaoweichang/business-admin-answer-helper

# 模型缓存目录（可选；默认 HF 用系统缓存，ModelScope 用仓库 .model_cache/）
# 建议放到空间充足的盘，例如：D:\hf_cache
# CACHE_DIR=

# 离线模式（可选；首次运行请保持 false，需要联网下载权重）
# LOCAL_FILES_ONLY=false

# 服务监听地址与端口
HOST=127.0.0.1
PORT=7860

# ==================== BAH Web v2 后端部署变量 ====================
# Web 版架构：浏览器 → Next.js 前端 → FastAPI 网关 → 云端 vLLM → Qwen2.5-3B + BAH LoRA
# 前端只需 NEXT_PUBLIC_API_BASE_URL；下列密钥一律只放后端环境，绝不进前端

APP_NAME=BAH API
APP_VERSION=2.0.0
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# 本地测试用 mock（无需 GPU）；云端部署后改为 remote
INFERENCE_MODE=mock
VLLM_BASE_URL=http://127.0.0.1:8000
VLLM_API_KEY=replace-with-a-long-random-secret
VLLM_MODEL=bah
MODEL_VERSION=BAH-HF-v2

# Supabase 分析（创建项目后在 Settings -> API Keys 获取）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 管理后台密钥（/api/admin/* 接口与 /admin 页面用）
ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET

MAX_NEW_TOKENS=1024
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=120
MAX_HISTORY_MESSAGES=8
MAX_MESSAGE_CHARS=6000
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_WINDOW_SECONDS=60
ANALYTICS_OPTIONAL=true
