# 工商管理答题助手（BAH）环境配置示例
# 用法：复制为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）
#   cp .env.example .env
# 留空/不设置 = 使用代码内默认值。

# 基座模型：HF 名或本地路径（默认 Qwen/Qwen2.5-3B-Instruct）
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# LoRA 适配器：HF 仓库名 或 本地 adapter 目录
# 中国大陆用户可改用 ModelScope 仓库：zhao1145141919/business-admin-answer-helper
ADAPTER_PATH=zhaoweichang/business-admin-answer-helper

# 模型缓存目录（可选；默认用 HuggingFace 默认缓存位置）
# 建议放到空间充足的盘，例如：D:\hf_cache
# CACHE_DIR=

# 离线模式（可选；首次运行请保持 false，需要联网下载权重）
# LOCAL_FILES_ONLY=false

# 服务监听地址与端口
HOST=127.0.0.1
PORT=7860
